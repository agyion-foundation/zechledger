# ─── Access security (required) ────────────────────────────────────────
# Generate a random value of at least 16 characters: openssl rand -hex 32
ZECHLEDGER_ADMIN_TOKEN=
# Deliberate opt-out only for a fully network-isolated local presentation;
# NEVER set this to true in production.
ZECHLEDGER_UNSAFE_DEMO_NO_AUTH=false
# Set to true behind a TLS reverse proxy; use false for a plain http://127.0.0.1 Docker demo.
ZECHLEDGER_COOKIE_SECURE=false
# Set to true only when a trusted reverse proxy writes x-forwarded-for.
ZECHLEDGER_TRUST_PROXY=false

# Optional production-only Vercel Blob presentation mode. Wallet/send gates must remain off.
ZECHLEDGER_VERCEL_BLOB_DEMO=false
# ZECHLEDGER_VERCEL_BLOB_STATE_PATH=zechledger-demo/ledger.json
# BLOB_READ_WRITE_TOKEN=<provisioned-by-vercel-blob>

# ─── Live legal entity / owner (required for wallet mode) ─────────────
ZECHLEDGER_COMPANY_NAME=
ZECHLEDGER_COMPANY_LOGO_MARK=ZL
ZECHLEDGER_COMPANY_LEGAL_NAME=
ZECHLEDGER_COMPANY_TAX_ID=
ZECHLEDGER_OPERATOR_NAME=
ZECHLEDGER_FISCAL_PERIOD=2026
# Use integer TRY minor units; only a vault with environment metadata can produce live documents.
# ZECHLEDGER_VAULT_METADATA_MAP={"vault-export":{"name":"Export","purpose":"Collections","period":"2026","budgetTryKurus":220000000}}

# ─── ZechLedger · Current Zcash Z3 testnet connection ──────────────────────
# The node (Zebra) performs chain validation only. If left blank, the application
# uses the rate-limited public testnet gateway for its read-only status indicator.
ZEBRA_RPC_URL=http://127.0.0.1:18232
# Preferred method when using Z3 cookie authentication:
# ZEBRA_COOKIE_PATH=/path/to/z3-testnet-cookie/.cookie
# Alternative Basic Auth (regtest/private proxy):
# ZEBRA_RPC_USER=
# ZEBRA_RPC_PASSWORD=

# The wallet (Zallet) decrypts amounts and memos and signs transactions.
# The Z3 testnet host port is 40232.
ZALLET_RPC_URL=http://127.0.0.1:40232
# Zallet v0.1.0-beta.1 creates `.cookie` in its data directory
# (standard container: /var/lib/zallet/.cookie).
# Mount or synchronize the cookie to a read-only/0600 host path that the ZechLedger process can read.
ZALLET_COOKIE_PATH=
# Alternative Basic Auth only for a private proxy/compatibility setup:
# ZALLET_RPC_USER=
# ZALLET_RPC_PASSWORD=
# To restrict access to a specific Zallet account:
ZALLET_ACCOUNT_UUID=
# To map multiple purpose vaults to genuinely separate Zallet accounts (single-line JSON).
# ZALLET_ACCOUNT_UUID must be empty when using the multi-account map:
# ZALLET_VAULT_ACCOUNT_MAP={"<account-uuid-1>":"vault-export","<account-uuid-2>":"vault-operations","<account-uuid-3>":"vault-rnd"}
# ZCASH_VAULT_UFVK_MAP={"vault-export":"uviewtest1..."}
# ZCASH_VAULT_ADDRESS_MAP={"vault-export":"utest1...","vault-operations":"utest1...","vault-rnd":"utest1..."}

# Testnet Unified (utest1...) or Sapling (ztestsapling1...) addresses that you own.
ZCASH_RECEIVER_ADDRESS=
ZCASH_FROM_ADDRESS=

# Sending is DISABLED by default. Enable it deliberately only in the testnet wallet used for judging.
ZCASH_ALLOW_SEND=false
# Set to true only after separately verifying that the Zallet config has [external] broadcast=true.
ZALLET_EXTERNAL_BROADCAST_CONFIRMED=false
ZCASH_MIN_CONFIRMATIONS=10
ZCASH_PRIVACY_POLICY=FullPrivacy
ZCASH_RPC_TIMEOUT_MS=12000

# UI / local ledger
ZCASH_EXPLORER_TX_URL=https://zexplorer.app/testnet/tx/
ZECHLEDGER_DATA_DIR=.zechledger
ZECHLEDGER_DEMO_RATE_TRY=2950

# Legacy zcashd/compatible RPC supports status/read-only compatibility only;
# transaction import and sending are disabled:
# ZCASH_RPC_URL=http://127.0.0.1:18232
# ZCASH_RPC_USER=zechledger
# ZCASH_RPC_PASSWORD=change-me
# ZCASH_WALLET_FLAVOR=legacy
# ZCASH_FEE_ZEC=0.0001

# Optional persistent Ed25519 keypair paths (default: under ZECHLEDGER_DATA_DIR)
# ZECHLEDGER_AUDIT_PRIVATE_KEY_PATH=
# ZECHLEDGER_AUDIT_PUBLIC_KEY_PATH=
# Serverless alternative: base64-encoded PEM. Public key is optional but must match when supplied.
# ZECHLEDGER_AUDIT_PRIVATE_KEY_B64=
# ZECHLEDGER_AUDIT_PUBLIC_KEY_B64=
ZALLET_SYNC_MAX_ROWS=5000
